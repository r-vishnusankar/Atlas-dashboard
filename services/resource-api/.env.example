# SQLite (default) — file created next to the app
DATABASE_URL=sqlite:///./resource_tracker.db

# Postgres example:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/resource_tracker

# Shared secret Atlas sends as X-Resource-Token (leave empty to skip auth in local dev)
RESOURCE_SERVICE_TOKEN=

# CORS — Atlas static server origin(s)
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083,http://localhost:8080

HOST=127.0.0.1
PORT=8090

# Email — leave SMTP_HOST empty to write messages to outbox_mail.log
RESOURCE_EMAILS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=atlas-resources@localhost
SMTP_USE_TLS=true
NOTIFY_FALLBACK_EMAIL=
