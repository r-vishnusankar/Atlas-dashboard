# Copy to .env in the project root (never commit .env)
# Local: python serve.py reads these.
# Netlify: set GROQ_API_KEY (and optional GROQ_MODEL) in Site → Environment variables.
PORT=8083
GROQ_API_KEY=gsk_your_key_here
# Optional — defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional — Google PageSpeed Insights API key (higher quota). Works without a key too.
# Create at https://developers.google.com/speed/docs/insights/v5/get-started
# Netlify: set PAGESPEED_API_KEY in Site → Environment variables.
# PAGESPEED_API_KEY=AIza...
